#!/bin/sh
#
# Mechanical half of the code quality gate: a branch can be as ugly as it needs to
# be, main has no broken windows. This catches the part a machine can.
#
# Versioned here rather than in .git/hooks, which git does not track -- a hook that
# only exists on the machine that created it protects nothing on a fresh clone. It
# is wired up with, once per clone:
#
#     git config core.hooksPath .githooks
#
# Known limitation, deliberately not fixed: cargo sees the working tree, not the
# index, so a partial `git add` checks something other than what is being committed.
# The fix would be stashing unstaged changes mid-commit, which is a well-known way to
# lose work. Commit whole files and this never bites.
#
# The escape hatch is `git commit --no-verify`. It exists for the case where you know
# better; if you find yourself reaching for it twice in a row, the hook is not the
# problem.

set -e

# Docs-only commits are frequent here and gain nothing from a Rust build. This also
# makes the hook a clean no-op until the Cargo project lands.
if ! git diff --cached --name-only --diff-filter=ACMR |
     grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
    exit 0
fi

fail() {
    echo ""
    echo "pre-commit: FAILED on $1"
    echo "pre-commit: fix it, or bypass deliberately with: git commit --no-verify"
    exit 1
}

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check || fail "formatting"

# The lint LEVELS live in Cargo.toml's [workspace.lints], so they apply to every compile
# and are not restated here. This line only decides what gets COMPILED, and each flag
# closes a hole:
#
#   --all-targets   without it clippy lints neither tests nor examples, and there is more
#                   of that here than there is implementation
#   --all-features  without it the `hash-experiments` arms of `hash::Hasher` are never
#                   compiled, so they are never linted -- a whole code path exempt by
#                   accident
#   -D warnings     the levels are warnings by default so an editor shows them without
#                   blocking; the gate is what turns them fatal
echo "pre-commit: cargo clippy --workspace --all-targets --all-features -- -D warnings"
cargo clippy --workspace --all-targets --all-features -- -D warnings || fail "clippy"

echo "pre-commit: cargo test"
cargo test --quiet || fail "tests"

echo "pre-commit: ok"
